   </size>
  </property>
  <property name="windowTitle">
   <string>CRM - Mentor Interview</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QWidget#MentorInterviewPage {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0b1220, stop:1 #111c33);
}

/* ---------- Header card ---------- */
QFrame#headerFrame {
    background-color: #131c2e;
    border: 1px solid #26344f;
    border-radius: 14px;
}

QLabel#headerIcon {
    font-size: 34px;
    color: #22d3ee;
    padding-left: 8px;
}

QLabel#headerTitle {
    font-size: 24px;
    font-weight: 700;
    color: #e6edf7;
}

QLabel#headerSubtitle {
    font-size: 13px;
    color: #8b9bb4;
}

QLabel#headerBadge {
    font-size: 11px;
    font-weight: 700;
    color: #22d3ee;
    background-color: rgba(34, 211, 238, 0.16);
    border: 1px solid transparent;
    border-radius: 11px;
    padding: 4px 12px;
}
QLabel#headerBadge[admin="true"] {
    color: #fbbf24;
    background-color: rgba(251, 191, 36, 0.14);
}

/* ---------- Toolbar card ---------- */
QFrame#cardFrame {
    background-color: #131c2e;
    border: 1px solid #26344f;
    border-radius: 14px;
}

/* ---------- Search input ---------- */
QLineEdit#searchInput {
    background-color: #0b1220;
    color: #e6edf7;
    border: 1px solid #26344f;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 13px;
    min-height: 20px;
    selection-background-color: #22d3ee;
    selection-color: #04222b;
}
QLineEdit#searchInput:hover {
    border-color: #8b9bb4;
}
QLineEdit#searchInput:focus {
    border: 1px solid #22d3ee;
}

/* ---------- Buttons (default = primary cyan) ---------- */
QPushButton {
    background-color: #22d3ee;
    color: #04222b;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-weight: 600;
    font-size: 13px;
    min-height: 20px;
}
QPushButton:hover   { background-color: #67e8f9; }
QPushButton:pressed { background-color: #06b6d4; }

/* ---------- All Conversations (secondary) ---------- */
QPushButton#allConversationsButton {
    background-color: #1b2740;
    color: #e6edf7;
    border: 1px solid #26344f;
}
QPushButton#allConversationsButton:hover {
    border-color: #22d3ee;
    color: #22d3ee;
}
QPushButton#allConversationsButton:pressed {
    background-color: #26344f;
}

/* ---------- Return (secondary) ---------- */
QPushButton#returnButton {
    background-color: #1b2740;
    color: #e6edf7;
    border: 1px solid #26344f;
}
QPushButton#returnButton:hover {
    border-color: #22d3ee;
    color: #22d3ee;
}
QPushButton#returnButton:pressed {
    background-color: #26344f;
}

/* ---------- ComboBox ---------- */
QComboBox#categoryComboBox {
    background-color: #0b1220;
    color: #e6edf7;
    border: 1px solid #26344f;
    border-radius: 10px;
    padding: 10px 14px;
    min-height: 20px;
    font-size: 13px;
}
QComboBox#categoryComboBox:hover {
    border-color: #8b9bb4;
}
QComboBox#categoryComboBox:focus {
    border: 1px solid #22d3ee;
}
QComboBox#categoryComboBox::drop-down {
    border: none;
    width: 30px;
}
QComboBox#categoryComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #8b9bb4;
    width: 0;
    height: 0;
    margin-right: 10px;
}
QComboBox#categoryComboBox QAbstractItemView {
    background-color: #131c2e;
    color: #e6edf7;
    border: 1px solid #26344f;
    outline: 0;
    padding: 4px;
    selection-background-color: rgba(34, 211, 238, 0.16);
    selection-color: #e6edf7;
}

/* ---------- Table ---------- */
QTableWidget#conversationsTable {
    background-color: #131c2e;
    alternate-background-color: #162136;
    color: #e6edf7;
    border: 1px solid #26344f;
    border-radius: 12px;
    outline: 0;
    gridline-color: transparent;
    font-size: 13px;
    selection-background-color: rgba(34, 211, 238, 0.16);
    selection-color: #e6edf7;
}
QTableWidget#conversationsTable::item {
    padding: 4px 10px;
    border: none;
}
QTableWidget#conversationsTable::item:selected {
    background-color: rgba(34, 211, 238, 0.16);
    color: #e6edf7;
}
QHeaderView {
    background: transparent;
}
QHeaderView::section {
    background-color: #1b2740;
    color: #8b9bb4;
    padding: 11px 12px;
    border: none;
    border-bottom: 1px solid #26344f;
    font-size: 11px;
    font-weight: 700;
}
QTableCornerButton::section {
    background-color: #1b2740;
    border: none;
}

/* ---------- Status label ---------- */
QLabel#statusLabel {
    color: #8b9bb4;
    font-size: 12px;
    padding: 4px 8px;
}
QLabel#statusLabel[error="true"] {
    color: #f87171;
    font-weight: 600;
}</string>
  </property>

