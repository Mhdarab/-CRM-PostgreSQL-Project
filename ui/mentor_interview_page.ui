<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MentorInterviewPage</class>
 <widget class="QWidget" name="MentorInterviewPage">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1240</width>
    <height>700</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
