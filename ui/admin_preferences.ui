}

/* ---------- Main card ---------- */
QFrame#frmMenu {
    background-color: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 18px;
}

/* ---------- Buttons ---------- */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff, stop:1 #e6e9ee);
    color: #263238;
    border: 1px solid #b0bec5;
    border-radius: 8px;
    font-size: 13px;
    font-weight: bold;
    padding: 12px 16px;
    min-height: 42px;
    text-align: center;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #e3f2fd, stop:1 #bbdefb);
    border: 1px solid #64b5f6;
    color: #0d47a1;
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #bbdefb, stop:1 #90caf9);
}
QPushButton:focus {
    border: 2px solid #42a5f5;
}

/* ---------- Admin (highlighted) ---------- */
QPushButton#btnAdmin {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ef5350, stop:1 #e53935);
    color: #ffffff;
    border: 1px solid #c62828;
}
QPushButton#btnAdmin:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ff6659, stop:1 #d32f2f);
}
QPushButton#btnAdmin:pressed {
    background: #c62828;
}

/* ---------- Exit button ---------- */
QPushButton#btnExit {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #607d8b, stop:1 #455a64);
    color: #ffffff;
    border: 1px solid #37474f;
}
QPushButton#btnExit:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #78909c, stop:1 #546e7a);
}</string>
