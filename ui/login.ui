  <property name="styleSheet">
   <string notr="true">QWidget#LoginWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0f2027, stop:0.5 #203a43, stop:1 #2c5364);
}

QFrame#frmCard {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
}

QLabel#lblLogo {
    font-size: 30px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 4px;
}

QLabel#lblSubtitle {
    color: #b0bec5;
    font-size: 12px;
    letter-spacing: 1px;
}

QLabel#lblField {
    color: #90a4ae;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
}

QLineEdit {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border: 2px solid transparent;
    border-radius: 12px;
    padding: 10px 14px;
    font-size: 13px;
    min-height: 22px;
    selection-background-color: #26c6da;
}
QLineEdit:hover {
    background-color: rgba(255, 255, 255, 0.12);
}
QLineEdit:focus {
    border: 2px solid #26c6da;
    background-color: rgba(255, 255, 255, 0.14);
}

QCheckBox#chkShow {
    color: #cfd8dc;
    font-size: 12px;
    spacing: 8px;
}
QCheckBox#chkShow::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 2px solid #607d8b;
    background-color: transparent;
}
QCheckBox#chkShow::indicator:hover {
    border-color: #26c6da;
}
QCheckBox#chkShow::indicator:checked {
    background-color: #26c6da;
    border-color: #26c6da;
}

QPushButton#btnLogin {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #00acc1, stop:1 #26c6da);
    color: #ffffff;
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: bold;
    padding: 12px;
    min-height: 40px;
    letter-spacing: 1px;
}
QPushButton#btnLogin:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #26c6da, stop:1 #4dd0e1);
}
QPushButton#btnLogin:pressed {
    background: #00838f;
}

QPushButton#btnExit {
    background-color: transparent;
    color: #cfd8dc;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    font-size: 13px;
    font-weight: bold;
    padding: 10px;
    min-height: 36px;
}
QPushButton#btnExit:hover {
    border-color: #ef5350;
    color: #ef5350;
}

QLabel#lblError {
    color: #ff5252;
    font-size: 12px;
    font-weight: bold;
    padding: 4px;
}

QLabel#lblForgot {
    color: #90a4ae;
    font-size: 12px;
}
QLabel#lblForgot:hover {
    color: #26c6da;
}</string>
